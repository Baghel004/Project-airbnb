<%- layout("/layouts/boilerplate.ejs") %>
<div class="signContainer">
    <h1><span style="color: rgb(238, 59, 92);">L</span>ogin</h1>
    <div>
        <form action="/login" method="POST">
            <div>
            <label for="username"></label>
            <input class="input-c" type="text" id="username" name="username" placeholder="username" required>
            </div>

            <div>
            <label for="password"></label>
            <input class="input-c" type="password" id="password" name="password" placeholder="password" required>
            </div>

            <p style="font-size: 0.9rem; margin-top: 0.5rem;">New here? <a href="/signup">Create an account</a></p>

            <button  class="btn" type="submit" >Login</button>

        </form>
    </div>
</div>