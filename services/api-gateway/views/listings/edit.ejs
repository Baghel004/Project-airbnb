<%- layout("/layouts/boilerplate.ejs") %>
<body>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="form" enctype="multipart/form-data">
        <h1>Edit Listing</h1>
        <div class="formitems">
            Title
            <input name="listing[title]" value="<%= listing.title %>"  type="text" required>
        </div>
        <div class="formitems">
            Description
            <textarea name="listing[description]"  required><%= listing.description %></textarea>
        </div>
        <div style="margin-right: 50rem;">
            <img src="<%=finalurl%>" alt="img">
        </div>
        <div class="formitems ">
            Upload Image <small>(leave empty to keep current)</small>
            <input name="listing[image]" type="file" style="font-size: 1.4rem; height: 4rem;  ">
        </div>
        <div class="formitems twoitems">
            Price
            <input name="listing[price]" value="<%= listing.price %>" type="number" style="margin-bottom: 2rem;" required>
            Location
            <input name="listing[location]" value="<%= listing.location %>" type="text" required>
        </div>
        <div class="formitems">
            Country
            <input name="listing[country]" value="<%= listing.country %>" type="text" required>
        </div>
        <div class="formitems">
            Category
            <select name="listing[category]" style="padding: 0.5rem; font-size: 1rem;">
                <option value="">— none —</option>
                <% for (let c of ['Trending','Rooms','Iconic Cities','Mountains','Castles','Amazing Pools','Camping','Farms','Arctic','Domes','Boats']) { %>
                    <option value="<%= c %>" <%= listing.category === c ? 'selected' : '' %>><%= c %></option>
                <% } %>
            </select>
        </div>
        <button class="btn">Edit</button>
    </form>
</body>
