 <%- layout("layouts/boilerplate.ejs"); %>

 <body>
    <style>
        .allIcons a.oneIcon { text-decoration: none; color: inherit; opacity: 0.75; transition: opacity .15s, border-color .15s; border-bottom: 2px solid transparent; }
        .allIcons a.oneIcon:hover { opacity: 1; }
        .allIcons a.oneIcon.active-cat { opacity: 1; border-bottom: 2px solid #222; font-weight: 600; }
    </style>
    <%
        const categories = [
            { name: 'Trending', icon: 'fa-fire', all: true },
            { name: 'Rooms', icon: 'fa-bed' },
            { name: 'Iconic Cities', icon: 'fa-city' },
            { name: 'Mountains', icon: 'fa-mountain' },
            { name: 'Castles', icon: 'fa-chess-rook' },
            { name: 'Amazing Pools', icon: 'fa-person-swimming' },
            { name: 'Camping', icon: 'fa-campground' },
            { name: 'Farms', icon: 'fa-cow' },
            { name: 'Arctic', icon: 'fa-snowflake' },
            { name: 'Domes', icon: 'fa-igloo' },
            { name: 'Boats', icon: 'fa-sailboat' },
        ];
        const active = (typeof activeCategory !== 'undefined') ? activeCategory : null;
    %>
    <div class="allIcons">
        <% for (let c of categories) { %>
            <%
                const href = c.all ? '/listings' : ('/listings?category=' + encodeURIComponent(c.name));
                const isActive = c.all ? !active : (active === c.name);
            %>
            <a class="oneIcon <%= isActive ? 'active-cat' : '' %>" href="<%= href %>">
                <i class="fa-solid <%= c.icon %>"></i>
                <p><%= c.name %></p>
            </a>
        <% } %>
        <div class="oneIcon" style="border: 1px solid black; border-radius: 30px; position:relative; top: -12px; margin-left: 4rem; ">
            <div class="tax">
                <p><b>Display Taxes</b></p>
                <label class="switch">
                    <input id="swit" type="checkbox">
                    <span class="slider"></span>
                  </label>
            </div>

        </div>
    </div>
    <% if (!allListings || allListings.length === 0) { %>
        <p style="padding: 2rem 1rem; font-size: 1.2rem; text-align: center; width: 100%;">
            No listings<% if (active) { %> in "<%= active %>"<% } %> yet.
            <a href="/listings/new">Add one?</a>
        </p>
    <% } %>
    <div class="container1">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%= listing._id%>">
                <div class="cardcontainer">
                    <div class="imgdiv">
                        <img class="cardimg" src="<%= listing.image.url%>" alt="Image">
                    </div>
                    <div class="contentdiv">   
                            <span><%=listing.location%>, <%=listing.country%></span>
                            <br>
                            <span>&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</span>
                            &nbsp; &nbsp;
                            <span><i class="tax-info" style="display: none;">18% taxes</i></span>                    
                    </div>
                </div>
            </a>
            <% } %>
    </div>
    
          
</body>

<script>
    let taxswitch = document.querySelector("#swit");
    taxswitch.addEventListener("click",()=>{
        let checks = document.querySelectorAll(".tax-info");
        for (check of checks){

        if(check.style.display != "inline"){
            check.style.display = "inline";
        }else{
            check.style.display = "none";
        }}
    })
   

</script>



   
